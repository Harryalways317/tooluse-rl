# Simulated user: any OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
USER_SIM_MODEL=gpt-4.1-mini

# Policy under evaluation (e.g. a local vLLM). POLICY_BASE_URL / POLICY_API_KEY
# fall back to the OPENAI_* values above.
POLICY_MODEL=Qwen/Qwen3-8B
POLICY_BASE_URL=http://localhost:8000/v1
POLICY_API_KEY=EMPTY

# Optional: where fetched datasets live (default: ./data) and an explicit tau2 data dir.
# TOOLUSE_RL_DATA_DIR=/data/tooluse-rl
# TAU2_DATA_DIR=/path/to/tau2-bench/data
